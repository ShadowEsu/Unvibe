# Unvibe marketing site environment variables.
# Copy to .env.local only if you want durable waitlist storage, email, or analytics.
# With no env file at all, waitlist signups and /waitlist-admin work against a local JSON file.

# Durable waitlist storage. When both are set, signups are written to the waitlist_entries
# table in Supabase (run the SQL in supabase/migrations/ once against your project first).
# If either is missing, the site falls back to .data/waitlist.json (or /tmp on Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob is no longer the waitlist store (a Hobby-plan usage suspension made it
# unreadable). It is kept only as a salt source for anonymous site-visit hashing
# (siteStatsStore.ts) and for the one-time recovery script that reads any signups still
# sitting in the old Blob store. Safe to leave unset once that recovery has been done.
BLOB_READ_WRITE_TOKEN=
WAITLIST_ADMIN_TOKEN=

# Public site URL, used for metadata, sitemap, robots, and referral links.
NEXT_PUBLIC_SITE_URL=https://unvibe.site

# Founder-only /founder controls. Enter this passcode directly at /founder; no Google
# account is required. When unset, WAITLIST_ADMIN_TOKEN is accepted as a secure fallback.
FOUNDER_CONTROL_TOKEN=
# Legacy Google variables are no longer required for founder build control.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only comma-separated allow-list checked against the verified Supabase user email.
FOUNDER_EMAILS=
# Optional single-email legacy fallback.
FOUNDER_EMAIL=

# Server-only URL for the existing Unvibe API used by /app. Keep this HTTPS in production.
# Defaults to https://api.unvibe.site when omitted. Do not expose it through NEXT_PUBLIC_.
UNVIBE_APP_BACKEND_URL=https://api.unvibe.site

# Analytics (optional). When NEXT_PUBLIC_POSTHOG_KEY is empty, analytics is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Waitlist alerts are always sent to preston@unvibe.site by the server.
# This legacy variable is ignored so a deployment cannot accidentally redirect signup alerts.
WAITLIST_NOTIFY_EMAIL=preston@unvibe.site

# Optional email provider. Without RESEND_API_KEY, signups still save; founder email is skipped.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Unvibe Waitlist <onboarding@resend.dev>
# Temporary Resend onboarding recipient until the custom sending domain is verified.
# Keep server-only; remove after Resend accepts preston@unvibe.site as a sender.
RESEND_FALLBACK_EMAIL=

# The beta-invite sender uses the same Resend key and sender. First run
# `npm run send:beta-invites` to inspect recipients; add `-- --send` only when ready.

# Resend (beta invite emails). Get a key at resend.com. FROM must be on a domain you have
# verified in Resend, e.g. "Unvibe <preston@unvibe.site>". Without a key, npm run
# send:beta-invites always dry-runs even with --send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Unvibe <preston@unvibe.site>

# Optional demo video URL, or place a file at public/demo.mp4
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Optional overrides for /investors demo media (defaults to the public Blob objects).
NEXT_PUBLIC_INVESTOR_DEMO_VIDEO_URL=
NEXT_PUBLIC_INVESTOR_DMG_URL=
NEXT_PUBLIC_INVESTOR_WINDOWS_DOWNLOAD_URL=
NEXT_PUBLIC_INVESTOR_ZIP_URL=

# Private-beta download artifacts. Set these only after the matching artifact has passed
# release checks; blank values deliberately avoid exposing a stale download.
NEXT_PUBLIC_BETA_MAC_DOWNLOAD_URL=
NEXT_PUBLIC_BETA_WINDOWS_DOWNLOAD_URL=
