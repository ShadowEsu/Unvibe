# Unvibe marketing site environment variables.
# Copy to .env.local only if you want durable waitlist storage, email, or analytics.
# With no env file at all, waitlist signups and /waitlist-admin work against a local JSON file.

# Durable waitlist storage. When both are set, signups are written to the waitlist_entries
# table in Supabase (run the SQL in supabase/migrations/ once against your project first).
# If either is missing, the site falls back to .data/waitlist.json (or /tmp on Vercel).
# The waitlist and beta-download rate limits also live here
# (web/supabase/migrations/20261022080000_request_rate_limits.sql).
# Deployed without them, those forms answer 503; only local development counts in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set by Vercel at runtime; leave empty locally. With VERCEL_ENV=production the signup forms
# accept posts only from https://unvibe.site and https://www.unvibe.site. Previews also accept
# their own VERCEL_URL and VERCEL_BRANCH_URL, and local development accepts localhost.
VERCEL_ENV=
VERCEL_URL=
VERCEL_BRANCH_URL=

# Server-only secret (32+ random characters) that keys the rate-limit buckets with an HMAC, so
# stored buckets cannot be reversed to IPs or emails. Required when deployed: without it the
# waitlist and beta-download forms answer 503. Local development uses a built-in value.
RATE_LIMIT_KEY_SECRET=
# Optional overrides. Signup posts per client network (IPv4 address or IPv6 /64) per UTC day,
# across both forms (default 30), and signups that may send email per UTC day for the whole
# site (default 500; past it, both forms answer 503 "try again tomorrow").
SIGNUP_IP_DAILY_LIMIT=30
SIGNUP_EMAIL_DAILY_CEILING=500

# Vercel Blob is no longer the waitlist store (a Hobby-plan usage suspension made it
# unreadable). It is kept only as a salt source for anonymous site-visit hashing
# (siteStatsStore.ts) and for the one-time recovery script that reads any signups still
# sitting in the old Blob store. Safe to leave unset once that recovery has been done.
BLOB_READ_WRITE_TOKEN=
WAITLIST_ADMIN_TOKEN=

# Public site URL, used for metadata, sitemap, robots, and referral links.
NEXT_PUBLIC_SITE_URL=https://unvibe.site

# Founder-only /founder controls and desktop Google sign-in on /activate.
# Google OAuth is handled by the existing Supabase project.
# Add https://unvibe.site/founder and https://unvibe.site/activate to the Supabase
# redirect allow-list. Use the publishable key for new projects or the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only comma-separated allow-list checked against the verified Supabase user email.
FOUNDER_EMAILS=
# Optional single-email legacy fallback.
FOUNDER_EMAIL=

# Server-only URL for the existing Unvibe API used by /app. Keep this HTTPS in production.
# Defaults to https://api.unvibe.site when omitted. Do not expose it through NEXT_PUBLIC_.
UNVIBE_APP_BACKEND_URL=https://api.unvibe.site

# Analytics (optional). Named events only. No autocapture, no session replay.
# Browser SDK token is public by Mixpanel design. Server token is the API fallback.
NEXT_PUBLIC_MIXPANEL_TOKEN=
MIXPANEL_TOKEN=
MIXPANEL_HOST=https://api.mixpanel.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=562518
POSTHOG_APP_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=

# Waitlist alerts are always sent to support@unvibe.site by the server.
# This legacy variable is ignored so a deployment cannot accidentally redirect signup alerts.
WAITLIST_NOTIFY_EMAIL=support@unvibe.site

# Optional email provider. Without RESEND_API_KEY, signups still save; founder email is skipped.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Unvibe Waitlist <onboarding@resend.dev>
# Temporary Resend onboarding recipient until the custom sending domain is verified.
# Keep server-only; remove once Resend has verified the sending domain (unvibe.site is verified).
RESEND_FALLBACK_EMAIL=

# The beta-invite sender uses the same Resend key and sender. First run
# `npm run send:beta-invites` to inspect recipients; add `-- --send` only when ready.

# Resend (beta invite emails). Get a key at resend.com. FROM must be on a domain you have
# verified in Resend, e.g. "Unvibe Beta <beta@unvibe.site>". Without a key, npm run
# send:beta-invites always dry-runs even with --send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Unvibe Beta <beta@unvibe.site>

# Founder /stats: desktop app user counts from the product backend (web/ /api/v1/admin/stats).
# UNVIBE_API_URL is the backend origin; the token must match the backend's UNVIBE_ADMIN_STATS_TOKEN.
UNVIBE_API_URL=
UNVIBE_ADMIN_STATS_TOKEN=

# Optional salt for hashing visitor IPs on feedback rate limits (any random string).
FEEDBACK_IP_SALT=
# Signs the bonus links in emails (feedback month of Pro). Falls back to the Supabase service key.
REWARD_LINK_SECRET=
# Secret part of the private stats page address: https://unvibe.site/s/<STATS_PAGE_KEY>. 16+ characters.
STATS_PAGE_KEY=
# Base URL of the Unvibe API for the homepage "try it" box. Defaults to https://api.unvibe.site.
NEXT_PUBLIC_UNVIBE_API=
# Outage switch, set only together with the API's AI_MAINTENANCE=1: 1 makes the Try box say "AI features
# are paused for maintenance. Back soon." and send nothing. Build-time; leave unset normally.
NEXT_PUBLIC_AI_MAINTENANCE=
