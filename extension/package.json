{
  "name": "uncode",
  "displayName": "Unvibe",
  "description": "Understand, verify, and retain AI-generated code. Send a selected snippet to the private Unvibe desktop review flow.",
  "version": "0.1.3",
  "publisher": "uncode",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uncode.reviewSelectionInDesktop",
        "title": "Unvibe: Understand Selection in Desktop App"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "uncode.reviewSelectionInDesktop",
          "when": "editorHasSelection",
          "group": "uncode@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "uncode.reviewSelectionInDesktop",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --out release/unvibe-desktop-bridge-0.1.3.vsix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
