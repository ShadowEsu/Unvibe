# Uncode backend environment. Set these in deployment secrets, never in Electron or browser code.
# APP_ENV: development | staging | production. Staging/production must not silently use MemoryStore or mock AI.
APP_ENV=development
WEB_BASE_URL=http://localhost:8787
LOG_LEVEL=info
ENABLE_ANALYTICS=false

# AI — required for real explanations in staging/production. Server-only.
# Every AI route (the app's explanations and questions, the website's Try it) uses only Anthropic's
# Claude API (claude-haiku-5-5), because the consent screen and the privacy policy name it. No other
# provider key is read. Each call is metered in ai_spend_days: $1 per UTC day and $20 in total, then
# AI pauses (src/ai/spendMeter.ts). Production only, stored as a sensitive variable; never Preview.
ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
# Outage switch: 1 pauses every hosted AI call before anything is reserved or sent, and the app, quiz and
# Try answer "AI features are paused for maintenance. Back soon." Leave unset normally.
AI_MAINTENANCE=
# Plan limits are centralized in src/billing/plans.ts and enforced server-side.
# Development only: the labelled mock answers when this is true outside production. Production ignores it.
ENABLE_MOCK_AI=true

# Desktop trial builds (sealed DMG). Shared opaque token — NOT a Gemini/Anthropic key.
# Bake the same value into the app as UNVIBE_TRIAL_TOKEN at package time.
UNVIBE_TRIAL_TOKEN=
# Founder dashboard: bearer secret (24+ chars) for GET /api/v1/admin/stats (aggregate install counts only).
UNVIBE_ADMIN_STATS_TOKEN=
# CI-only bearer secret (32+ random bytes) that can only flag a test install as QA (POST /api/v1/admin/qa-install).
UNVIBE_QA_FLAG_TOKEN=
UNVIBE_TRIAL_EXPLANATION_LIMIT=50
UNVIBE_TRIAL_FOLLOW_UP_LIMIT=50
UNVIBE_TRIAL_GLOBAL_LIMIT=50000

# Supabase — SUPABASE_URL and service-role key are required for real sync, durable trial counters,
# activation markers and admin stats. Server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth is configured in Supabase Dashboard → Authentication → Providers → Google
# (not read by this app at runtime). Google Cloud redirect URI must be:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Supabase Auth → URL Configuration must allow:
#   https://api.unvibe.site/activate
#   http://localhost:8787/activate

# Authentication safety
# Direct email sign-in is a local-development convenience only. Leave false in production;
# production builds must use the verified device/auth flow before they issue bearer tokens.
UNCODE_ALLOW_DEV_EMAIL_AUTH=false

# Gift codes: HMAC secret (32+ random characters, server-only, e.g. `openssl rand -base64 48`).
# Unset or shorter means gifts are off: /api/v1/gifts/mine and /api/v1/gifts/claim answer 503.
# Rotating it changes every gift code and share link.
GIFT_CODE_SECRET=

# Billing — server-only. Leave unset to keep checkout disabled. Configure TEST mode first.
# APP_URL is the server-only dashboard origin used for trusted Checkout/Portal return URLs.
# PUBLIC_APP_URL remains supported only while older deployments are migrated.
APP_URL=http://localhost:8787
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_LIFETIME=
# Optional — only if Teams checkout is offered again
STRIPE_PRICE_TEAMS_MONTHLY=
STRIPE_PRICE_TEAMS_ANNUAL=
BILLING_GRACE_PERIOD_DAYS=7

# Optional HMAC key for the hashed visitor IPs behind the public Try it rate limit. Falls back to
# SUPABASE_SERVICE_ROLE_KEY; with neither set, Try it answers 503 in production.
TRY_IP_SALT=
